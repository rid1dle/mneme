#!/bin/zsh
# scripts/release <version> "<what changed>"
# Sets the version, runs the tests, commits, tags and pushes. GitHub Actions then builds, signs and publishes the
# release, and every copy of Mneme 0.4 or later updates itself to it.
set -euo pipefail
cd "$(dirname "$0")/.."
(( $# == 2 )) || { echo 'usage: scripts/release 0.5 "What changed"' >&2; exit 2; }
v=$1 notes=$2
[[ $v =~ '^[0-9]+(\.[0-9]+)+$' ]] || { echo "not a version: $v" >&2; exit 2; }
[[ -z $(git status --porcelain) ]] || { echo "commit or stash your changes first" >&2; exit 1; }
[[ $(git branch --show-current) == main ]] || { echo "release from main" >&2; exit 1; }
cur=$(/usr/libexec/PlistBuddy -c "Print CFBundleShortVersionString" Resources/Info.plist)
b=$(/usr/libexec/PlistBuddy -c "Print CFBundleVersion" Resources/Info.plist)
sed -i '' -e "s#<key>CFBundleShortVersionString</key><string>$cur</string>#<key>CFBundleShortVersionString</key><string>$v</string>#" \
          -e "s#<key>CFBundleVersion</key><string>$b</string>#<key>CFBundleVersion</key><string>$((b + 1))</string>#" Resources/Info.plist
./build.sh test
git commit -qam "Version $v"
git tag -a "v$v" -m "$notes"
git -c credential.helper= -c "credential.helper=!gh auth git-credential" push --atomic origin main "v$v"
echo "Pushed v$v. GitHub Actions is building, signing and publishing it: gh run watch -R rid1dle/mneme"
